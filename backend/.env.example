# ========================================
# Plateforme Anti-Arnaque — Variables d'environnement
# ========================================
# Copie ce fichier en .env et remplis les valeurs.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SQL Server ---
DB_NAME=ArnaqueBD
DB_USER=your_sql_username
DB_PASSWORD=your_sql_password
DB_HOST=localhost
DB_PORT=1433
